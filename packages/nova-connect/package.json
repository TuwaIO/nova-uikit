{
  "name": "@tuwaio/nova-connect",
  "version": "0.7.2",
  "private": false,
  "author": "Oleksandr Tkach",
  "license": "Apache-2.0",
  "description": "Layer 7 (L7) of the TUWA Ecosystem. React components, hooks, and providers for wallet connection, blockchain interactions, and SIWX auto-authentication. Built on @tuwaio/satellite-react.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "require": "./dist/components/index.cjs"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "require": "./dist/hooks/index.cjs"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js",
      "require": "./dist/i18n/index.cjs"
    },
    "./satellite": {
      "types": "./dist/satellite/index.d.ts",
      "import": "./dist/satellite/index.js",
      "require": "./dist/satellite/index.cjs"
    },
    "./evm": {
      "types": "./dist/evm/index.d.ts",
      "import": "./dist/evm/index.js",
      "require": "./dist/evm/index.cjs"
    },
    "./solana": {
      "types": "./dist/solana/index.d.ts",
      "import": "./dist/solana/index.js",
      "require": "./dist/solana/index.cjs"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "socket.json"
  ],
  "scripts": {
    "start": "tsup src/index.ts --watch",
    "build": "tsup && pnpm exec postcss ./src/styles/app.css -o ./dist/index.css",
    "test": "vitest run"
  },
  "keywords": [
    "web3",
    "connect",
    "wallet",
    "wagmi",
    "viem",
    "zustand",
    "react",
    "ui",
    "i18n",
    "modal",
    "toast",
    "design-system",
    "nova",
    "tuwa"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuwaIO/nova-uikit.git",
    "directory": "packages/nova-connect"
  },
  "homepage": "https://github.com/TuwaIO/nova-uikit",
  "bugs": {
    "url": "https://github.com/TuwaIO/nova-uikit/issues"
  },
  "contributors": [
    {
      "name": "Oleksandr Tkach",
      "url": "https://github.com/Argeare5"
    }
  ],
  "peerDependencies": {
