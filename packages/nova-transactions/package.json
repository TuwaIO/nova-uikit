{
  "name": "@tuwaio/nova-transactions",
  "version": "0.5.3",
  "private": false,
  "author": "Oleksandr Tkach",
  "license": "Apache-2.0",
  "description": "Layer 7 (L7) of the TUWA Ecosystem. React component library providing the visual UI for @tuwaio/pulsar-core transaction lifecycle tracking.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js",
      "require": "./dist/providers/index.cjs"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "socket.json"
  ],
  "scripts": {
    "build": "tsup && pnpm exec postcss ./src/styles/app.css -o ./dist/index.css",
    "test": "vitest run"
  },
  "keywords": [
    "react",
    "web3",
    "hooks",
    "transaction",
    "tracking",
    "ui",
    "components",
    "tailwind",
    "wagmi",
    "viem",
    "i18n",
    "modal",
    "toast",
    "design-system",
    "nova",
    "tuwa"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuwaIO/nova-uikit.git",
    "directory": "packages/nova-transactions"
  },
  "homepage": "https://github.com/TuwaIO/nova-uikit",
  "bugs": {
    "url": "https://github.com/TuwaIO/nova-uikit/issues"
  },
  "contributors": [
    {
      "name": "Oleksandr Tkach",
      "url": "https://github.com/Argeare5"
    }
  ],
  "peerDependencies": {
    "@web3icons/react": ">=4",
    "@web3icons/common": ">=0.11",
    "@heroicons/react": "2.x.x",
    "@radix-ui/react-dialog": "1.x.x",
    "framer-motion": "12.x.x",
    "react": ">=19.2.3",
    "react-toastify": ">=11",
    "@tuwaio/pulsar-core": ">=0.7",
    "@tuwaio/nova-core": "workspace:^",
    "@tuwaio/orbit-core": ">=0.3",
    "dayjs": "1.x.x"
  },
  "devDependencies": {
    "@tuwaio/orbit-core": "1.0.0-feat-update-alpha.2.addd21d",
    "@tuwaio/pulsar-core": "1.0.0-feat-update-alpha.1.ea1149b",
    "@tuwaio/nova-core": "workspace:^",
    "dayjs": "^1.11.23",
    "@web3icons/react": "^4.1.21",
    "@web3icons/common": "^0.11.50",
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.18",
    "autoprefixer": "^10.5.5",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "immer": "^11.1.18",
    "postcss": "^8.5.28",
    "postcss-cli": "^12.0.0",
    "react": "^19.2.8",
    "react-toastify": "^11.1.0",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15",
    "vitest": "4.1.11"
  }
